# ---------------------------------------------------------------------------
# Public runtime config. Anything prefixed EXPO_PUBLIC_ is inlined into the
# JS bundle at build time and is therefore NOT secret. Never put private keys,
# service-role tokens, or signing secrets here — those belong on your backend.
# ---------------------------------------------------------------------------

# Which environment this build represents: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Base URL for the API layer (swap when you plug in a real backend).
EXPO_PUBLIC_API_URL=https://api.example.com

# Toggle the dummy/mock auth + API layer. Set to false once a real
# provider is wired up. Lets you ship the same binary against mocks.
EXPO_PUBLIC_USE_MOCKS=true

# Vendor keys for analytics / crash reporting (left blank — no vendor yet).
EXPO_PUBLIC_ANALYTICS_KEY=
EXPO_PUBLIC_SENTRY_DSN=
