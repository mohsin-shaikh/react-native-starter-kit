# Expo / React Native + pnpm.
#
# Metro's resolver doesn't follow pnpm's default symlinked store, so use a
# hoisted node_modules layout (flat, like npm/yarn). This is the officially
# recommended setting for Expo with pnpm.
node-linker=hoisted

# Some Expo/RN packages rely on peers being hoisted to the root.
shamefully-hoist=true
